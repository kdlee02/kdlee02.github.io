---
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/blog/Headline.astro';
import Button from '~/components/ui/Button.astro';
import { GITHUB_URL, LINKEDIN_URL } from '~/navigation';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About',
};

const focus = [
  { text: 'RAG', slug: 'rag' },
  { text: 'AI Agents', slug: 'ai-agents' },
  { text: 'MCP', slug: 'mcp' },
  { text: 'AI Evaluation', slug: 'ai-evaluation' },
  { text: 'AI Product Engineering', slug: 'ai-product-engineering' },
];
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-3xl">
    <Headline>About</Headline>

    <p class="text-lg text-muted dark:text-slate-400">
      {/* TODO: replace with a real introduction. */}
      Placeholder — who you are and what you work on.
    </p>

    <h2 class="mt-12 text-2xl font-bold">Focus</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        focus.map((item) => (
          <li>
            <a
              class="inline-block rounded border border-gray-200 dark:border-slate-700 px-3 py-1 text-sm text-muted dark:text-slate-400 hover:text-primary dark:hover:text-blue-400"
              href={getPermalink(item.slug, 'category')}
            >
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 flex flex-wrap gap-4">
      <Button variant="secondary" href={GITHUB_URL} target="_blank">GitHub</Button>
      <Button variant="secondary" href={LINKEDIN_URL} target="_blank">LinkedIn</Button>
    </div>
  </section>
</Layout>
