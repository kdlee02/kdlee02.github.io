---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
  currentPage?: number;
  lastPage?: number;
  currentUrl?: string;
}

// `prevUrl`/`nextUrl` come from Astro's `page.url` and already include `base`
// and honour `trailingSlash`, so they must not go through `getPermalink()`
// (that would prefix `base` a second time, see #629).
const {
  prevUrl,
  nextUrl,
  prevText = 'Newer posts',
  nextText = 'Older posts',
  currentPage = 1,
  lastPage = 1,
  currentUrl = '',
} = Astro.props;

// Page 1 lives at the list root, the rest at `<root>/<n>`. Show a window of up to 10 page numbers around the current one.
const trailingSlash = currentUrl.endsWith('/');
const root = currentUrl.replace(/\/\d+\/?$/, '');
const pageUrl = (n: number) => (n === 1 ? root || '/' : `${root}/${n}${trailingSlash ? '/' : ''}`);
const first = Math.max(1, Math.min(currentPage - 4, lastPage - 9));
const last = Math.min(lastPage, first + 9);
const numbers = Array.from({ length: last - first + 1 }, (_, i) => first + i);
---

{
  (prevUrl || nextUrl) && (
    <div class="container flex">
      <div class="flex flex-row mx-auto container justify-between">
        <Button variant="tertiary" class={`md:px-3 px-3 mr-2 ${!prevUrl ? 'invisible' : ''}`} href={prevUrl}>
          <Icon name="tabler:chevron-left" class="w-6 h-6" />
          <p class="ml-2">{prevText}</p>
        </Button>

        {lastPage > 1 && (
          <nav aria-label="Pagination" class="hidden sm:flex items-center gap-1">
            {numbers.map((n) => (
              <a
                href={pageUrl(n)}
                aria-current={n === currentPage ? 'page' : undefined}
                class={`px-3 py-1 rounded-md ${n === currentPage ? 'bg-primary text-white font-semibold' : 'hover:bg-gray-100 dark:hover:bg-slate-800'}`}
              >
                {n}
              </a>
            ))}
          </nav>
        )}

        <Button variant="tertiary" class={`md:px-3 px-3 ${!nextUrl ? 'invisible' : ''}`} href={nextUrl}>
          <span class="mr-2">{nextText}</span>
          <Icon name="tabler:chevron-right" class="w-6 h-6" />
        </Button>
      </div>
    </div>
  )
}
