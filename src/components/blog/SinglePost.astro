---
import type { ImageMetadata } from 'astro';
import PostTags from '~/components/blog/Tags.astro';
import PostToc from '~/components/blog/PostToc.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { fetchSeriesPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;

const cover = typeof post.image === 'string' ? post.image : (post.image as ImageMetadata | undefined)?.src;
const seriesPosts = post.series ? await fetchSeriesPosts(post.series.slug) : [];
const index = seriesPosts.findIndex((item) => item.slug === post.slug);
const previous = index > 0 ? seriesPosts[index - 1] : undefined;
const next = index >= 0 ? seriesPosts[index + 1] : undefined;
---

<section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12 lg:py-16">
  <article>
    <header class="max-w-3xl">
      <p class="mb-4 font-mono text-sm text-muted">
        {
          post.series ? (
            <span class="text-primary">
              {post.series.title} · Part {post.series.part} of {seriesPosts.length}
            </span>
          ) : (
            post.category && (
              <a class="text-primary hover:underline" href={getPermalink(post.category.slug, 'category')}>
                {post.category.title}
              </a>
            )
          )
        }
        {' · '}
        <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
        {
          post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
            <>
              {' · Updated '}
              <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate)}</time>
            </>
          )
        }
        {post.readingTime && <> · {post.readingTime} min read</>}
      </p>
      <h1
        class="font-heading text-4xl font-semibold leading-[1.08] tracking-tighter text-heading text-balance md:text-5xl"
      >
        {post.title}
      </h1>
      <p class="mt-5 text-lg text-muted text-pretty md:text-xl">{post.excerpt}</p>
    </header>

    <div class="mt-10 xl:grid xl:grid-cols-[minmax(0,46rem)_17rem] xl:justify-between xl:gap-16">
      <div class="min-w-0 max-w-[46rem]">
        {
          cover && (
            <img
              src={cover}
              alt={post.imageAlt || ''}
              width="1200"
              height="630"
              loading="eager"
              fetchpriority="high"
              class="mb-8 w-full rounded-xl border border-line"
            />
          )
        }

        <details class="mb-8 rounded-xl border border-line bg-card xl:hidden">
          <summary class="cursor-pointer px-5 py-3 font-medium">On this page</summary>
          <div class="px-5 pb-5 pt-2">
            <PostToc post={post} seriesPosts={seriesPosts} />
          </div>
        </details>

        {
          post.takeaways && post.takeaways.length > 0 && (
            <aside class="mb-10 rounded-xl border border-primary/40 bg-primary/5 p-6">
              <h2 class="mb-3 font-mono text-xs uppercase tracking-wide text-primary">Key ideas</h2>
              <ul class="list-disc space-y-2 pl-5 marker:text-primary">
                {post.takeaways.map((idea) => (
                  <li>{idea}</li>
                ))}
              </ul>
            </aside>
          )
        }

        <div data-post-body class="prose prose-lg max-w-none prose-headings:scroll-mt-[90px] prose-li:my-1">
          <slot />
        </div>

        {
          (previous || next) && (
            <nav aria-label="Series" class="mt-12 grid gap-4 sm:grid-cols-2">
              {[
                { item: previous, label: 'Previous part' },
                { item: next, label: 'Next part' },
              ].map(({ item, label }) =>
                item ? (
                  <a
                    href={getPermalink(item.permalink, 'post')}
                    class="rounded-xl border border-line bg-card p-5 transition duration-200 ease-out hover:-translate-y-0.5 hover:border-primary"
                  >
                    <span class="font-mono text-xs uppercase tracking-wide text-muted">{label}</span>
                    <span class="mt-1 block font-semibold text-heading">{item.title}</span>
                  </a>
                ) : (
                  <span class="hidden sm:block" />
                )
              )}
            </nav>
          )
        }

        <div class="mt-10 flex flex-col justify-between sm:flex-row">
          <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
          <SocialShare
            url={url}
            text={post.title}
            class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600"
          />
        </div>
      </div>

      <aside class="hidden xl:block">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pb-4">
          <PostToc post={post} seriesPosts={seriesPosts} />
        </div>
      </aside>
    </div>
  </article>
</section>

<dialog data-zoom class="m-auto max-h-[94vh] max-w-[94vw] cursor-zoom-out rounded-xl bg-white p-2 backdrop:bg-black/70">
  <img alt="" class="max-h-[90vh] w-auto max-w-full" />
</dialog>

<script>
  const init = () => {
    const body = document.querySelector<HTMLElement>('[data-post-body]');
    if (!body) return;

    // Copy button on every code block.
    for (const pre of body.querySelectorAll('pre')) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = 'Copy';
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
        button.textContent = 'Copied';
        setTimeout(() => (button.textContent = 'Copy'), 1500);
      });
      pre.append(button);
    }

    // Click a diagram to see it full size.
    const dialog = document.querySelector<HTMLDialogElement>('[data-zoom]')!;
    const big = dialog.querySelector('img')!;
    dialog.addEventListener('click', () => dialog.close());
    for (const image of body.querySelectorAll('img'))
      image.addEventListener('click', () => {
        big.src = image.currentSrc || image.src;
        big.alt = image.alt;
        dialog.showModal();
      });

    // Mark the section being read in the table of contents.
    const links = new Map<string, HTMLAnchorElement[]>();
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')) {
      const id = decodeURIComponent(link.hash.slice(1));
      links.set(id, [...(links.get(id) ?? []), link]);
    }
    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries.find((item) => item.isIntersecting);
        if (!entry) return;
        for (const [id, group] of links)
          for (const link of group)
            if (id === entry.target.id) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
      },
      { rootMargin: '-90px 0px -70% 0px' }
    );
    for (const heading of body.querySelectorAll('h2[id], h3[id]')) observer.observe(heading);
  };
  document.addEventListener('astro:page-load', init);
</script>
