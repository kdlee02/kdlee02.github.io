---
import { fetchPosts } from '~/utils/blog';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';

export interface Props {
  /** Slug of the category currently being shown, or undefined on the "All" view. */
  current?: string;
}

const { current } = Astro.props;

// Categories are whatever the published posts actually use — no separate list to maintain.
const categories = [
  ...new Map(
    (await fetchPosts()).flatMap((post) => (post.category ? [[post.category.slug, post.category]] : []))
  ).values(),
].sort((a, b) => a.title.localeCompare(b.title));

const items = [
  { slug: undefined, title: 'All', href: getBlogPermalink() },
  ...categories.map((category) => ({
    slug: category.slug,
    title: category.title,
    href: getPermalink(category.slug, 'category'),
  })),
];

const base = 'inline-block rounded border px-3 py-1 text-sm transition';
const active = 'border-primary text-primary dark:border-blue-400 dark:text-blue-400';
const idle =
  'border-gray-200 dark:border-slate-700 text-muted dark:text-slate-400 hover:text-primary dark:hover:text-blue-400';
---

{
  categories.length > 0 && (
    <ul class="mb-10 flex flex-wrap gap-2">
      {items.map((item) => (
        <li>
          <a href={item.href} class={`${base} ${item.slug === current ? active : idle}`}>
            {item.title}
          </a>
        </li>
      ))}
    </ul>
  )
}
