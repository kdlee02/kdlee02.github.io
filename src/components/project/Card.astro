---
import type { Project } from '~/utils/projects';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const link = getPermalink(`/projects/${project.id}`);
---

<a
  href={link}
  class="flex flex-col h-full rounded-xl border border-line bg-card p-6 transition duration-200 ease-out hover:-translate-y-0.5 hover:border-primary"
>
  <h3 class="text-xl font-semibold leading-tight text-heading">{project.data.title}</h3>
  {project.data.excerpt && <p class="mt-3 text-muted dark:text-slate-400 grow">{project.data.excerpt}</p>}
  {
    project.data.stack?.length && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.data.stack.map((item) => (
          <li class="rounded bg-gray-100 dark:bg-slate-800 px-2 py-1 text-xs text-muted dark:text-slate-400">{item}</li>
        ))}
      </ul>
    )
  }
</a>
